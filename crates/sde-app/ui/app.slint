import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ListView, ScrollView } from "std-widgets.slint";

// Milestone 5 shell: a title bar, an "open file" button, a searchable
// channel list + lap picker/comparison sidebar, and a worksheet of
// channel docks (one line graph per selected channel, each able to
// overlay several laps at once, sharing one draggable vertical time
// cursor and one non-linear-editor-style zoom/pan window), laid out
// stacked, side-by-side, or in a grid. Declarative markup only — all
// data/logic lives in Rust (src/main.rs, src/graph.rs) per
// PROJECT_PLAN.md's stated preference for keeping markup separate from
// logic.

export struct SeriesData {
    commands: string,
    color: color,
    // Channel name this trace belongs to, but only set (non-"") when a
    // dock overlays more than one channel — otherwise the dock header
    // already names the (single) channel and the top `legend` property
    // already names laps when comparing, so this would be redundant.
    label: string,
}

export struct DockData {
    channel-name: string,
    channel-units: string,
    // One series per (channel, lap) combination in the dock: normally
    // just one channel x one lap/"All"; more when comparing laps and/or
    // overlaying multiple channels in one dock (see
    // `graph::build_lap_comparison_plot`).
    series: [SeriesData],
    view-width: float,
    view-height: float,
    has-data: bool,
    status-text: string,
    // Precomputed by Rust (a fixed 2-column grid) so the "Grid" layout
    // mode below never needs modulo/division inside markup.
    grid-row: int,
    grid-col: int,
}

// One line in the setup panel: either a group header or a value/diff row.
// Flat rather than nested because that's what a `ListView` consumes — see
// `setup_view::SetupRow`.
export struct SetupRowData {
    is-group: bool,
    label: string,
    value: string,
    // Percentage change on a diff row; empty otherwise.
    detail: string,
}

export struct LegendEntry {
    label: string,
    color: color,
}

// One channel's graph row: header (name/units, cursor readout, remove
// button) plus the graph itself (traces, shared cursor line, and the
// scroll-wheel zoom/pan hookup). Factored out of `AppWindow` so the
// three worksheet layout modes below (stacked/side-by-side/grid) can
// each place the same dock content without tripling the markup.
component DockPanel {
    in property <DockData> dock;
    in property <bool> cursor-visible;
    in property <float> cursor-fraction;
    in property <string> cursor-value;
    // This dock is the one currently being dragged by its header.
    in property <bool> dragging;
    // A drag (of some *other* dock) is currently hovering this one, so it
    // is what a release right now would act on.
    in property <bool> drop-highlight;
    // Whether that release would merge into this dock (Ctrl held) rather
    // than move the dragged dock into this position.
    in property <bool> drop-merges;

    callback removed();
    callback cursor-moved(float); // fraction 0..1 across the graph width
    callback zoom-scrolled(float, float, float); // delta-x, delta-y, cursor fraction

    // Header-drag lifecycle. `drag-moved` reports the offset from where
    // the drag started plus this dock's own size, which is all Rust needs
    // to work out which dock is being hovered — see
    // `graph::drag_drop_target` — and whether Ctrl is held, which picks
    // between reordering and merging.
    callback drag-started();
    callback drag-moved(float, float, float, float, bool); // dx, dy, cell width, cell height, ctrl held
    callback drag-ended();

    // Whether Ctrl was held as of the last pointer event of this drag.
    // Sampled from `pointer-event` (which carries live modifiers) rather
    // than from `moved` (which carries none), and read back in `moved`,
    // which Slint always fires immediately after the matching
    // `PointerEventKind.move`.
    private property <bool> ctrl-held;

    VerticalLayout {
        padding: 0px;
        spacing: 2px;

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            // The dock's name doubles as its drag handle: drag it onto
            // another dock to move it into that position, or hold Ctrl to
            // merge the two into one overlay group instead (matching the
            // sidebar, where Ctrl+click already means "overlay"). Done
            // with a plain TouchArea rather than Slint's DragArea/
            // DropArea, whose payload type is only reachable through
            // `slint::private_unstable_api`.
            TouchArea {
                horizontal-stretch: 1;
                min-height: 20px;
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;

                Text {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.dock.channel-name + " (" + root.dock.channel-units + ")";
                    font-size: 13px;
                    color: root.dragging ? #4ea1ff : gray;
                    overflow: elide;
                }

                pointer-event(event) => {
                    root.ctrl-held = event.modifiers.control;
                    if (event.kind == PointerEventKind.down) {
                        root.drag-started();
                    }
                    // `up` and `cancel` both end the drag; Rust decides
                    // what actually happens from whichever target and
                    // modifier the last `drag-moved` reported, and a
                    // cancelled drag never moved far enough to have one.
                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.drag-ended();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.drag-moved(
                            (self.mouse-x - self.pressed-x) / 1px,
                            (self.mouse-y - self.pressed-y) / 1px,
                            root.width / 1px,
                            root.height / 1px,
                            root.ctrl-held);
                    }
                }
            }
            Text {
                // Kept out of `DockData` so dragging the cursor only has
                // to update this one small string, not rebuild every
                // dock's path commands. Fixed width (rather than sizing
                // to content) so the row doesn't reflow — and the "x"
                // button doesn't visibly shift — every time the value's
                // digit count changes as the cursor moves.
                text: root.cursor-visible ? root.cursor-value : "";
                font-size: 13px;
                color: gray;
                min-width: 160px;
                horizontal-alignment: right;
                overflow: elide;
            }
            Button {
                text: "x";
                width: 22px;
                clicked => { root.removed(); }
            }
        }

        // Per-channel color key, shown only for an overlay dock (more
        // than one channel plotted together) — a plain single-channel
        // dock's header already names its one channel, and lap
        // comparison already has its own top-level legend.
        if root.dock.series.length > 1 && root.dock.series[0].label != "": HorizontalLayout {
            spacing: 10px;
            for s in root.dock.series: HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    background: s.color;
                }
                Text {
                    text: s.label;
                    font-size: 10px;
                    color: gray;
                }
            }
        }

        Rectangle {
            // Two visually distinct drops at the same drag geometry: a
            // merge (Ctrl) tints the whole dock blue, since its contents
            // are about to absorb the dragged one; a reorder only outlines
            // it in amber, since nothing about its contents changes — it
            // is just the position being landed on.
            background: root.drop-highlight && root.drop-merges ? #23303f : #1b1e24;
            border-width: root.drop-highlight ? 2px : 1px;
            border-color: root.drop-highlight
                ? (root.drop-merges ? #4ea1ff : #e6a44a)
                : #3a3f4b;
            // The dock being dragged fades so the highlighted drop target
            // reads as the thing about to receive it.
            opacity: root.dragging ? 0.55 : 1.0;
            vertical-stretch: 1;
            clip: true;

            if !root.dock.has-data: Text {
                text: root.dock.status-text;
                font-size: 12px;
                color: gray;
            }

            TouchArea {
                width: 100%;
                height: 100%;

                moved => {
                    if (self.pressed && self.width > 0px) {
                        root.cursor-moved(max(0.0, min(1.0, self.mouse-x / self.width)));
                    }
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && self.width > 0px) {
                        root.cursor-moved(max(0.0, min(1.0, self.mouse-x / self.width)));
                    }
                }
                scroll-event(event) => {
                    root.zoom-scrolled(event.delta-x / 1px, event.delta-y / 1px, max(0.0, min(1.0, self.mouse-x / self.width)));
                    accept
                }
            }

            for s in root.dock.series: Path {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                commands: s.commands;
                stroke: s.color;
                stroke-width: 1.5px;
                viewbox-width: root.dock.view-width;
                viewbox-height: root.dock.view-height;
                // Path defaults to `fit: contain`, which preserves the
                // viewbox's aspect ratio and letterboxes — since the
                // viewbox is always a 1000x1000 square (see
                // `VIEW_WIDTH`/`VIEW_HEIGHT` in main.rs) but docks are
                // wide rectangles, that left large blank margins on
                // either side of the trace. `fill` stretches x/y
                // independently to the element's actual size instead,
                // which is what a time/value plot needs.
                fit: fill;
            }

            if root.cursor-visible: Rectangle {
                x: root.cursor-fraction * parent.width - 1px;
                y: 0px;
                width: 2px;
                height: 100%;
                background: #ff5a5a;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "sde-app";
    preferred-width: 1100px;
    preferred-height: 640px;

    // -- state provided by Rust --
    in property <string> window-title: "sde-app — No file loaded";
    in property <string> status-text: "Open a .ld, .ibt, or .tsv telemetry log to begin.";
    in property <bool> cursor-visible: false;
    in property <float> cursor-fraction: 0; // 0..1 across the plotted x range
    in property <string> cursor-time-text: "";
    in property <[string]> cursor-values: []; // aligned with `docks`
    in property <[string]> channel-names: []; // filtered by channel-filter-text
    in property <[bool]> channel-active: []; // aligned with channel-names: on a dock already
    in property <[bool]> channel-overlay-pending: []; // aligned with channel-names: queued (Ctrl+click) for a new overlay dock
    in property <[string]> overlay-pending-names: []; // the queue itself, for display
    in property <string> channel-filter-text: "";
    in property <[string]> lap-labels: []; // "All", "Lap 1 (...)", ...
    in property <int> current-lap-index: 0;
    in property <[string]> compare-lap-labels: []; // "1", "2", ... one per lap
    in property <[bool]> compare-lap-active: []; // aligned with compare-lap-labels
    in property <string> compare-status-text: ""; // e.g. "Comparing 2 laps"; "" when not comparing
    in property <[LegendEntry]> legend: []; // populated only while comparing laps
    in property <[DockData]> docks: []; // one row per channel added to the worksheet
    in-out property <string> math-name-text: ""; // cleared by Rust after a successful add
    in-out property <string> math-formula-text: "";
    in property <string> math-channel-error: ""; // shown after a failed add
    in property <[string]> math-channel-names: []; // created math channels, for removal chips
    in property <string> zoom-range-text: ""; // e.g. "12.0s - 48.0s of 120.7s"; "" when fully zoomed out
    in-out property <int> layout-mode: 0; // 0 = stacked, 1 = side-by-side, 2 = grid; pure UI state
    in property <string> axis-mode-label: "Time"; // "Time" or "Distance"
    in property <bool> axis-distance-available: false; // whether the loaded session has a distance channel
    in property <string> install-status-text: ""; // RBR install root validation summary; "" until one is set
    in property <string> replay-status-text: ""; // loaded .rpl/.ini metadata + recovery cross-check summary
    in property <[SetupRowData]> setup-rows: []; // the setup sheet, or only what differs while comparing
    in property <string> setup-panel-title: ""; // e.g. "Tarmac Bumpy" or "Tarmac Bumpy -> my tarmac test"
    in property <string> setup-panel-subtitle: ""; // e.g. "274 values" / "73 values differ"
    in property <bool> setup-comparing: false; // whether `setup-rows` is a diff rather than one sheet
    in-out property <bool> setup-panel-visible: false; // pure UI state: whether the panel is shown at all
    // Header-drag state, both indices into `docks` and both -1 when idle:
    // the dock being dragged, and the dock a release would merge it into
    // (computed in Rust by `graph::drag_drop_target`).
    in property <int> dock-drag-source: -1;
    in property <int> dock-drag-target: -1;
    // Whether releasing now would merge into `dock-drag-target` (Ctrl held)
    // rather than move the dragged dock into that position.
    in property <bool> dock-drag-merges: false;

    // -- callbacks into Rust --
    callback open-file();
    callback set-install-root();
    callback open-replay-info();
    callback cursor-moved(float); // fraction 0..1 across the graph width
    callback channel-filter-changed(string);
    callback dock-selected(string); // toggles a channel in/out of the worksheet as its own dock
    callback dock-removed(int); // index into `docks`
    callback dock-drag-started(int); // index into `docks`: begin dragging that dock's header
    callback dock-drag-moved(int, float, float, float, float, bool); // source index, dx, dy, cell width, cell height, ctrl held
    callback dock-drag-ended(); // reorder into (or, with ctrl, merge into) `dock-drag-target` if there is one, then clear the drag
    callback channel-overlay-toggled(string); // toggles a channel in/out of the overlay queue
    callback overlay-add-requested(); // create one new dock overlaying the queued channels
    callback overlay-cleared(); // empty the overlay queue without creating a dock
    callback lap-selected(int); // index into lap-labels
    callback compare-lap-toggled(int); // index into compare-lap-labels
    callback compare-cleared(); // exit comparison mode entirely, back to the plain lap dropdown
    callback math-channel-add-requested(string, string); // name, formula
    callback math-channel-removed(int); // index into math-channel-names
    callback zoom-scrolled(float, float, float); // delta-x, delta-y, cursor fraction
    callback zoom-reset();
    callback axis-mode-toggled(); // flips between Time and Distance
    callback open-setup(); // pick a .lsp to show as the current run's setup
    callback compare-setup(); // pick a .lsp to diff the current setup against
    callback setup-comparison-cleared(); // back to showing the single sheet

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Button {
                text: "Open file...";
                clicked => { root.open-file(); }
            }
            Button {
                text: "RBR install root...";
                clicked => { root.set-install-root(); }
            }
            Button {
                text: "Open replay info...";
                clicked => { root.open-replay-info(); }
            }
            // Pure UI state (like `layout-mode`): showing/hiding the panel
            // doesn't change what's loaded, so it needs no Rust round-trip.
            // Hand-rolled toggle rather than a checkable `Button`, for the
            // same binding-severing reason documented on the layout chips.
            Rectangle {
                width: 60px;
                height: 24px;
                background: root.setup-panel-visible ? #4ea1ff : #2a2f3a;
                border-radius: 3px;
                TouchArea {
                    clicked => { root.setup-panel-visible = !root.setup-panel-visible; }
                }
                Text {
                    text: "Setup";
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            Text {
                text: root.window-title;
                vertical-alignment: center;
                font-weight: 600;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                // A single-lap session is a continuous stage/hillclimb
                // run, not a lap-timed circuit (see `graph::lap_labels`'s
                // "Full Run" label for that case) — "Lap:" would be a
                // misleading prefix for its one dropdown entry.
                text: root.lap-labels.length == 1 ? "Run:" : "Lap:";
                vertical-alignment: center;
            }
            // Whenever the compare chips (below) have any lap selected,
            // they take over entirely — the dropdown's own selection is
            // ignored (see `current_ranges` in main.rs). Rather than
            // leave the dropdown showing a stale, now-irrelevant value
            // (confusing: which one is actually in effect?), swap it for
            // an explicit "Comparing N laps" indicator with its own way
            // back out, so exactly one control is ever showing what's
            // active.
            if root.compare-status-text == "": ComboBox {
                width: 160px;
                model: root.lap-labels;
                current-index: root.current-lap-index;
                selected(value) => {
                    root.lap-selected(self.current-index);
                }
            }
            if root.compare-status-text != "": HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.compare-status-text;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: #4ea1ff;
                }
                Button {
                    text: "Clear";
                    clicked => { root.compare-cleared(); }
                }
            }
            Text {
                text: "Compare:";
                vertical-alignment: center;
            }
            // Fixed-width and horizontally scrollable rather than an
            // unbounded row: a long circuit session can have 20-50+
            // laps, which would otherwise overflow off the edge of the
            // window with no way to reach the later ones.
            ScrollView {
                width: 200px;
                height: 30px;
                vertical-scrollbar-policy: always-off;
                HorizontalLayout {
                    spacing: 2px;
                    for lbl[i] in root.compare-lap-labels: Rectangle {
                        width: 22px;
                        height: 22px;
                        background: (i < root.compare-lap-active.length && root.compare-lap-active[i])
                            ? #4ea1ff : #2a2f3a;
                        border-radius: 3px;
                        TouchArea {
                            clicked => { root.compare-lap-toggled(i); }
                        }
                        Text {
                            text: lbl;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }

        if root.install-status-text != "" || root.replay-status-text != "": VerticalLayout {
            spacing: 2px;
            if root.install-status-text != "": Text {
                text: root.install-status-text;
                font-size: 12px;
                color: gray;
                wrap: word-wrap;
            }
            if root.replay-status-text != "": Text {
                text: root.replay-status-text;
                font-size: 12px;
                color: gray;
                wrap: word-wrap;
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;

            Text {
                text: "Layout:";
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 2px;
                // Hand-rolled toggle chips rather than `Button {
                // checkable: true; checked: ...; }`: `Button`'s built-in
                // checked-toggle assigns to its own `checked` property
                // internally on click, which severs any external
                // declarative binding on it after the first click — so a
                // `checked: root.layout-mode == N` binding would stop
                // updating and the highlight would get stuck. A plain
                // Rectangle whose background is a pure expression of
                // `layout-mode` has no such internal state to fight with.
                Rectangle {
                    width: 70px;
                    height: 24px;
                    background: root.layout-mode == 0 ? #4ea1ff : #2a2f3a;
                    border-radius: 3px;
                    TouchArea {
                        clicked => { root.layout-mode = 0; }
                    }
                    Text {
                        text: "Stacked";
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 100px;
                    height: 24px;
                    background: root.layout-mode == 1 ? #4ea1ff : #2a2f3a;
                    border-radius: 3px;
                    TouchArea {
                        clicked => { root.layout-mode = 1; }
                    }
                    Text {
                        text: "Side-by-side";
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                Rectangle {
                    width: 50px;
                    height: 24px;
                    background: root.layout-mode == 2 ? #4ea1ff : #2a2f3a;
                    border-radius: 3px;
                    TouchArea {
                        clicked => { root.layout-mode = 2; }
                    }
                    Text {
                        text: "Grid";
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            Text {
                text: "Axis:";
                vertical-alignment: center;
            }
            // Distance mode falls back to time silently when unavailable
            // (see `graph::build_lap_comparison_plot`), but a disabled-
            // looking toggle communicates *why* nothing changed rather
            // than leaving it looking broken.
            Rectangle {
                width: 90px;
                height: 24px;
                background: !root.axis-distance-available
                    ? #2a2f3a
                    : (root.axis-mode-label == "Distance" ? #4ea1ff : #2a2f3a);
                opacity: root.axis-distance-available ? 1.0 : 0.5;
                border-radius: 3px;
                TouchArea {
                    enabled: root.axis-distance-available;
                    clicked => { root.axis-mode-toggled(); }
                }
                Text {
                    text: root.axis-mode-label;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Non-linear-video-editor-style timeline zoom: scroll (wheel
            // or trackpad) over any dock zooms in/out around the pointer;
            // shift-scroll/horizontal-swipe pans. This just shows the
            // current window and offers a way back to fully zoomed out,
            // since there's no on-canvas ruler/scrubber (yet).
            if root.zoom-range-text != "": HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Zoom: " + root.zoom-range-text;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: gray;
                }
                Button {
                    text: "Reset zoom";
                    clicked => { root.zoom-reset(); }
                }
            }
        }

        if root.legend.length > 0: HorizontalBox {
            padding: 0px;
            spacing: 16px;
            for entry in root.legend: HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    background: entry.color;
                }
                Text {
                    text: entry.label;
                    font-size: 12px;
                    color: gray;
                }
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            vertical-stretch: 1;

            VerticalBox {
                padding: 0px;
                spacing: 4px;
                width: 220px;

                LineEdit {
                    placeholder-text: "Search channels...";
                    text: root.channel-filter-text;
                    edited(text) => { root.channel-filter-changed(text); }
                }
                Text {
                    text: "Click to plot; Ctrl+click to queue an overlay";
                    font-size: 10px;
                    color: gray;
                    wrap: word-wrap;
                }

                ListView {
                    vertical-stretch: 1;
                    for name[i] in root.channel-names: Rectangle {
                        height: 26px;
                        background: (i < root.channel-overlay-pending.length && root.channel-overlay-pending[i])
                            ? #4a3420
                            : (i < root.channel-active.length && root.channel-active[i])
                                ? #2a3040 : transparent;
                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    if (event.modifiers.control) {
                                        root.channel-overlay-toggled(name);
                                    } else {
                                        root.dock-selected(name);
                                    }
                                }
                            }
                        }
                        Text {
                            x: 4px;
                            text: name;
                            vertical-alignment: center;
                            height: 100%;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }

                if root.overlay-pending-names.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Overlay queue:";
                        font-size: 11px;
                        color: gray;
                    }
                    for name in root.overlay-pending-names: Text {
                        text: "  " + name;
                        font-size: 11px;
                        color: #ffb060;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Add overlay dock";
                            clicked => { root.overlay-add-requested(); }
                        }
                        Button {
                            text: "Clear";
                            clicked => { root.overlay-cleared(); }
                        }
                    }
                }

                Text {
                    text: "Math channel";
                    font-size: 12px;
                    color: gray;
                }
                LineEdit {
                    text <=> root.math-name-text;
                    placeholder-text: "Name";
                }
                LineEdit {
                    text <=> root.math-formula-text;
                    placeholder-text: "e.g. [Ground Speed] * 3.6";
                }
                Button {
                    text: "Add math channel";
                    clicked => {
                        root.math-channel-add-requested(root.math-name-text, root.math-formula-text);
                    }
                }
                if root.math-channel-error != "": Text {
                    text: root.math-channel-error;
                    font-size: 11px;
                    color: #ff5a5a;
                    wrap: word-wrap;
                }
                for name[i] in root.math-channel-names: HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: name;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "x";
                        width: 18px;
                        clicked => { root.math-channel-removed(i); }
                    }
                }
            }

            VerticalBox {
                padding: 0px;
                spacing: 8px;
                vertical-stretch: 1;

                if root.docks.length == 0: Text {
                    text: root.status-text;
                    font-size: 13px;
                    color: gray;
                }

                if root.docks.length > 0 && root.layout-mode == 0: ListView {
                    vertical-stretch: 1;
                    for dock[i] in root.docks: Rectangle {
                        height: 160px;
                        DockPanel {
                            width: 100%;
                            height: 100%;
                            dock: dock;
                            cursor-visible: root.cursor-visible;
                            cursor-fraction: root.cursor-fraction;
                            cursor-value: i < root.cursor-values.length ? root.cursor-values[i] : "";
                            dragging: root.dock-drag-source == i;
                            drop-highlight: root.dock-drag-target == i;
                            drop-merges: root.dock-drag-merges;
                            removed => { root.dock-removed(i); }
                            cursor-moved(f) => { root.cursor-moved(f); }
                            zoom-scrolled(dx, dy, f) => { root.zoom-scrolled(dx, dy, f); }
                            drag-started => { root.dock-drag-started(i); }
                            drag-moved(dx, dy, w, h, ctrl) => { root.dock-drag-moved(i, dx, dy, w, h, ctrl); }
                            drag-ended => { root.dock-drag-ended(); }
                        }
                    }
                }

                if root.docks.length > 0 && root.layout-mode == 1: HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    for dock[i] in root.docks: Rectangle {
                        horizontal-stretch: 1;
                        DockPanel {
                            width: 100%;
                            height: 100%;
                            dock: dock;
                            cursor-visible: root.cursor-visible;
                            cursor-fraction: root.cursor-fraction;
                            cursor-value: i < root.cursor-values.length ? root.cursor-values[i] : "";
                            dragging: root.dock-drag-source == i;
                            drop-highlight: root.dock-drag-target == i;
                            drop-merges: root.dock-drag-merges;
                            removed => { root.dock-removed(i); }
                            cursor-moved(f) => { root.cursor-moved(f); }
                            zoom-scrolled(dx, dy, f) => { root.zoom-scrolled(dx, dy, f); }
                            drag-started => { root.dock-drag-started(i); }
                            drag-moved(dx, dy, w, h, ctrl) => { root.dock-drag-moved(i, dx, dy, w, h, ctrl); }
                            drag-ended => { root.dock-drag-ended(); }
                        }
                    }
                }

                // Grid: a fixed 2-column layout using `grid-row`/`grid-col`
                // precomputed on each `DockData` in Rust (avoids needing
                // modulo/division inside markup). Absolutely positioned
                // within one Rectangle rather than a Slint `GridLayout`,
                // since the dock count/row count is dynamic.
                if root.docks.length > 0 && root.layout-mode == 2: Rectangle {
                    vertical-stretch: 1;
                    for dock[i] in root.docks: Rectangle {
                        x: dock.grid-col * (parent.width / 2);
                        y: dock.grid-row * 200px;
                        width: parent.width / 2 - 8px;
                        height: 192px;
                        DockPanel {
                            width: 100%;
                            height: 100%;
                            dock: dock;
                            cursor-visible: root.cursor-visible;
                            cursor-fraction: root.cursor-fraction;
                            cursor-value: i < root.cursor-values.length ? root.cursor-values[i] : "";
                            dragging: root.dock-drag-source == i;
                            drop-highlight: root.dock-drag-target == i;
                            drop-merges: root.dock-drag-merges;
                            removed => { root.dock-removed(i); }
                            cursor-moved(f) => { root.cursor-moved(f); }
                            zoom-scrolled(dx, dy, f) => { root.zoom-scrolled(dx, dy, f); }
                            drag-started => { root.dock-drag-started(i); }
                            drag-moved(dx, dy, w, h, ctrl) => { root.dock-drag-moved(i, dx, dy, w, h, ctrl); }
                            drag-ended => { root.dock-drag-ended(); }
                        }
                    }
                }

                Text {
                    // Fully formatted in Rust (includes the "t = "/"d = "
                    // prefix and unit), since which is shown depends on
                    // `axis-mode-label`.
                    text: root.cursor-visible ? root.cursor-time-text : "";
                }
            }

            // Setup panel: the loaded run's `.lsp` sheet, or — once a
            // second setup is picked to compare against — only the values
            // that differ between them. Milestone 6 / the UI-UX design
            // note's principle 8 (setup-diff-aware comparison).
            //
            // Always instantiated, collapsed to zero width when hidden,
            // rather than wrapped in `if`: an `if` adds and removes a
            // child of this HorizontalBox, and toggling it on did not
            // reliably produce a visible panel until some *other* change
            // forced the layout to run again. A width binding is an
            // ordinary relayout trigger with no element construction
            // involved, and matches how the sidebar (which never had this
            // problem) sits in the same layout.
            //
            // `clip: true` plus a fixed-width inner `VerticalBox` (rather
            // than `width: 100%`, which would go to 0 along with the
            // outer `Rectangle`): collapsing the *content*'s own width to
            // 0 made its `wrap: word-wrap` subtitle `Text` measure its
            // wrap against a 0px line, which Slint computed as an
            // extremely tall (near-unbounded) preferred height — and
            // since `visible: false` keeps the element in the layout
            // tree (unlike `if`), that inflated height became the whole
            // window's minimum height, blocking vertical resize and
            // making the window open taller than the display. Keeping
            // the inner content at its expanded width at all times avoids
            // the pathological wrap, while `clip: true` still hides it
            // when the outer `Rectangle` collapses.
            Rectangle {
                width: root.setup-panel-visible ? 340px : 0px;
                visible: root.setup-panel-visible;
                clip: true;

                VerticalBox {
                    width: 340px;
                    height: 100%;
                    padding: 0px;
                    spacing: 4px;

                    Text {
                        text: root.setup-panel-title != "" ? root.setup-panel-title : "Setup";
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.setup-panel-subtitle != "": Text {
                        text: root.setup-panel-subtitle;
                        font-size: 11px;
                        color: gray;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Open setup...";
                            clicked => { root.open-setup(); }
                        }
                        if !root.setup-comparing: Button {
                            text: "Compare...";
                            clicked => { root.compare-setup(); }
                        }
                        if root.setup-comparing: Button {
                            text: "Stop comparing";
                            clicked => { root.setup-comparison-cleared(); }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for row in root.setup-rows: Rectangle {
                            height: row.is-group ? 24px : 20px;
                            background: row.is-group ? #2a3040 : transparent;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 6px;
                                Text {
                                    text: row.label;
                                    font-size: row.is-group ? 12px : 11px;
                                    font-weight: row.is-group ? 600 : 400;
                                    color: row.is-group ? #4ea1ff : white;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if !row.is-group: Text {
                                    text: row.value;
                                    font-size: 11px;
                                    color: root.setup-comparing ? #ffb060 : gray;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                                if row.detail != "": Text {
                                    text: row.detail;
                                    font-size: 10px;
                                    color: gray;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 52px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
